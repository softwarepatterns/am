{
  "name": "@softwarepatterns/am",
  "version": "0.3.0",
  "description": "Auth client SDK for AccountMaker (Am)",
  "keywords": [
    "authentication",
    "auth",
    "sdk",
    "typescript",
    "oauth",
    "openid-connect",
    "jwt",
    "session-management"
  ],
  "author": "Your Name <info@example.com>",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/softwarepatterns/am/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarepatterns/am.git",
    "directory": "packages/am"
  },
  "homepage": "https://github.com/softwarepatterns/am/tree/main/packages/am#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:clean": "rm -rf dist",
    "build": "bun run build:clean && rollup -c",
    "prepublishOnly": "bun run build",
    "test": "bun test src",
    "test:unit": "bun test src",
    "test:integration": "NODE_TLS_REJECT_UNAUTHORIZED=0 bun --env-file=../../.env test test/integration",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint",
    "test:matrix": "./scripts/matrix.sh"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "oxlint": "^1.39.0",
    "rollup": "^4.55.1",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
