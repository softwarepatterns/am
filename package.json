{
  "name": "softwarepatterns-am",
  "private": true,
  "version": "0.0.0",
  "description": "Public AccountMaker SDK packages monorepo",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --if-present --workspaces build",
    "test": "bun run --if-present --workspaces test",
    "test:unit": "bun run --if-present --workspaces test:unit",
    "test:integration": "bun run --if-present --workspaces test:integration",
    "test:matrix": "bun run --if-present --workspaces test:matrix",
    "typecheck": "bun run --parallel --if-present --workspaces typecheck",
    "lint": "bun run --parallel --if-present --workspaces lint",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softwarepatterns/am.git"
  },
  "author": "Software Patterns <info@softwarepatterns.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "husky": "^9.1.7"
  },
  "packageManager": "bun@1.3.10"
}
